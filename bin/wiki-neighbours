#!/usr/bin/env python3
"""wiki-neighbours — the existing notes most similar to a source, for a prompt.

Read-only. Scores every note/*.md in the wiki against the source text by TF-IDF
cosine (stdlib, deterministic: ties break by title) and prints the top K as

  - [[Exact Note Title]] — the first N words of that note's one-paragraph précis

The single-call ingest (wiki-ingest-run, WIKI_INGEST_MODE=single) puts this
block in its prompt. It stands in for what the agentic ingest does with tools
(read index.md, grep note/, open the related pages): measured 2026-09-13
(wiki-model-prompt-optimise SPEC-2), single-call notes without it lost to the
agentic incumbents 5-7, and with it won 8-4, because the related-page sentences
could say what the other page actually claims.

Usage: wiki-neighbours --wiki DIR --source FILE [--k 12] [--words 120] [--exclude TITLE]...
Exit: 0 (prints nothing when the wiki has no notes); 2 usage or unreadable input.
"""
import argparse
import math
import os
import re
import sys
import unicodedata

TOKEN_RE = re.compile(r"[a-z][a-z0-9]{2,}")


def tokens(text):
    return TOKEN_RE.findall(text.lower())


def strip_frontmatter(text):
    if text.startswith("---\n"):
        end = text.find("\n---\n", 4)
        if end != -1:
            return text[end + 5:]
    return text


def precis(text):
    """The first prose paragraph after the H1."""
    body = re.sub(r"^\s*#\s+.*\n", "", text, count=1)
    for para in re.split(r"\n\s*\n", body):
        p = para.strip()
        if p and not p.startswith(("#", "---", ">", "|", "```")):
            return " ".join(p.split())
    return ""


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--wiki", required=True)
    ap.add_argument("--source", required=True)
    ap.add_argument("--k", type=int, default=12)
    ap.add_argument("--words", type=int, default=120)
    ap.add_argument("--exclude", action="append", default=[], help="a note title to leave out")
    a = ap.parse_args()
    try:
        source = strip_frontmatter(open(a.source, encoding="utf-8", errors="replace").read())
    except OSError as e:
        sys.stderr.write("wiki-neighbours: cannot read %s: %s\n" % (a.source, e))
        sys.exit(2)
    note_dir = os.path.join(a.wiki, "note")
    exclude = {unicodedata.normalize("NFC", t) for t in a.exclude}
    docs = []
    if os.path.isdir(note_dir):
        for fn in sorted(os.listdir(note_dir)):
            if not fn.endswith(".md"):
                continue
            title = unicodedata.normalize("NFC", fn[:-3])
            with open(os.path.join(note_dir, fn), encoding="utf-8", errors="replace") as fh:
                docs.append((title, fh.read()))
    if not docs:
        return
    n = len(docs)
    df, tfs = {}, []
    for _, text in docs:
        tf = {}
        for w in tokens(text):
            tf[w] = tf.get(w, 0) + 1
        tfs.append(tf)
        for w in tf:
            df[w] = df.get(w, 0) + 1
    unseen = math.log(n + 1) + 1
    idf = {w: math.log((n + 1) / (c + 1)) + 1 for w, c in df.items()}

    def vec(tf):
        v = {w: (1 + math.log(c)) * idf.get(w, unseen) for w, c in tf.items()}
        norm = math.sqrt(sum(x * x for x in v.values())) or 1.0
        return {w: x / norm for w, x in v.items()}

    qtf = {}
    for w in tokens(source):
        qtf[w] = qtf.get(w, 0) + 1
    q = vec(qtf)
    scored = []
    for (title, text), tf in zip(docs, tfs):
        if title in exclude:  # scored out, but still counted in the IDF
            continue
        v = vec(tf)
        small, big = (q, v) if len(q) < len(v) else (v, q)
        scored.append((sum(x * big.get(w, 0.0) for w, x in small.items()), title, text))
    scored.sort(key=lambda r: (-r[0], r[1]))
    out = []
    for _, title, text in scored[:a.k]:
        words = precis(text).split()
        out.append("- [[%s]] — %s%s" % (title, " ".join(words[:a.words]), " …" if len(words) > a.words else ""))
    sys.stdout.write("\n".join(out) + "\n")


if __name__ == "__main__":
    main()
