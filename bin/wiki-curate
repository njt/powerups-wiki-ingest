#!/usr/bin/env python3
"""wiki-curate — the curation operation Karpathy's pattern calls "lint".

The ingest pipeline (wiki-ingest-run) files sources. This tool operates on the
*whole corpus*: it builds the provenance and link graph, and reports on the
health of the wiki. It is deliberately deterministic — no LLM, no network — so
it is cheap enough to run every night and trustworthy enough to act on.

    wiki-curate index [--json]     build the graph; print a summary
    wiki-curate audit [--json]     health report (dead links, orphans, ...)
    wiki-curate themes [--min N]   topic pages ranked by source count

Config: WIKI_PATH (required), or --wiki. Read-only: this tool never writes to
the wiki. See docs/design/monograph-what-great-looks-like.md for the design.

Python 3.8+, standard library only.
"""

import argparse
import json
import os
import re
import sys
import unicodedata
from collections import defaultdict


def nfc(s):
    """Normalise to composed form.

    macOS and iCloud store filenames decomposed (NFD), while markdown written by
    an editor or a model is composed (NFC): `topic/Vibe Maths and the Erdős
    Breakthrough.md` is `Erdős` on disk and `Erdős` in every link to
    it. Obsidian resolves that; comparing raw bytes does not, and the whole
    corpus of accented titles reads as dead links and orphans on the live
    filesystem while looking clean inside a git worktree.
    """
    return unicodedata.normalize("NFC", s)

# [[Target]], [[Target|alias]], [[Target#anchor]], [[dir/Target]]
WIKILINK = re.compile(r"\[\[([^\]\[]+?)\]\]")
# Code is not markup. `[[ -z "$TMUX" ]]` is bash and `[[String: Any]]` is Swift;
# both appear in the corpus and neither is a wikilink.
CODE_FENCE = re.compile(r"^```.*?^```", re.M | re.S)
INLINE_CODE = re.compile(r"`[^`\n]*`")
# A "the wiki has N pages" style claim — self-referential and reliably stale.
SELF_COUNT = re.compile(
    r"(?:wiki(?:'s)?\s+(?:has|contains)|of\s+the\s+wiki's)\s+~?([\d,]+)\s+"
    r"(?:topic\s+)?pages?",
    re.I,
)
FRONTMATTER_KEY = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$")

WIKI_DIRS = ("topic", "summary", "raw")
# Bare [[Name]] can match several files. Prefer the authored page over the
# digest, and the digest over the verbatim archive -- alphabetical order gets
# this exactly backwards ("raw" < "summary" < "topic").
KIND_RANK = {"topic": 0, "summary": 1, "raw": 2}


def _rank(key):
    top = key.split("/", 1)[0] if "/" in key else ""
    return (KIND_RANK.get(top, 3), key)


def die(msg, code=2):
    print(f"wiki-curate: {msg}", file=sys.stderr)
    sys.exit(code)


def resolve_wiki(arg):
    wiki = arg or os.environ.get("WIKI_PATH")
    if not wiki:
        die("WIKI_PATH is not set and --wiki was not given.\n"
            "  export WIKI_PATH=/path/to/wiki")
    wiki = os.path.expanduser(wiki)
    if not os.path.isdir(wiki):
        die(f"not a directory: {wiki}")
    if not os.path.isdir(os.path.join(wiki, "topic")):
        die(f"no topic/ directory under {wiki} — is this a wiki?")
    return wiki


def read(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def parse_frontmatter(text):
    """Return (dict, body). Tolerant: the corpus predates any schema."""
    if not text.startswith("---"):
        return {}, text
    end = text.find("\n---", 3)
    if end == -1:
        return {}, text
    meta = {}
    for line in text[3:end].splitlines():
        m = FRONTMATTER_KEY.match(line.strip())
        if m:
            meta[m.group(1)] = m.group(2).strip().strip('"')
    return meta, text[end + 4:]


def link_targets(text):
    """Every wikilink target in `text`, normalised (alias and anchor stripped).

    Code spans are stripped first so that shell and Swift syntax in quoted
    source is not mistaken for markup.
    """
    text = CODE_FENCE.sub("", text)
    text = INLINE_CODE.sub("", text)
    out = []
    for raw in WIKILINK.findall(text):
        t = raw.split("|", 1)[0].split("#", 1)[0].strip()
        if t:
            out.append(t)
    return out


class Vault:
    """The corpus: wiki pages, plus every file that can satisfy a wikilink.

    Obsidian resolves [[Name]] by basename anywhere in the vault, so link
    resolution must consider non-wiki content (Agent Journals/, etc.) even
    though those files are not wiki pages and are never audited.
    """

    def __init__(self, wiki):
        self.wiki = wiki
        self.pages = {}          # "topic/Foo" -> record
        self.by_basename = defaultdict(list)   # "Foo" -> [relpaths]
        self._scan()
        self._link()

    def _scan(self):
        for dirpath, dirnames, filenames in os.walk(self.wiki):
            dirnames[:] = [d for d in dirnames if d != ".git"]
            for fn in filenames:
                if not fn.endswith(".md"):
                    continue
                full = os.path.join(dirpath, fn)
                rel = nfc(os.path.relpath(full, self.wiki))
                key = rel[:-3]                      # drop .md
                base = os.path.basename(key)
                self.by_basename[base].append(key)
                top = rel.split(os.sep, 1)[0]
                if top not in WIKI_DIRS:
                    continue                        # linkable, not a wiki page
                text = read(full)
                meta, body = parse_frontmatter(text)
                # raw/ is verbatim source, not authored markup: any [[...]] in
                # it belongs to the original document and is not a wikilink.
                authored = top != "raw"
                self.pages[key] = {
                    "key": key,
                    "kind": top,
                    "title": base,
                    "path": rel,
                    "meta": meta,
                    "authored": authored,
                    "words": len(body.split()),
                    "links": link_targets(body) if authored else [],
                    "body": body,
                }

    def resolve(self, target):
        """Resolve a wikilink target to a vault key, or None."""
        target = nfc(target)
        if target in self.by_basename:
            hits = self.by_basename[target]
            return hits[0] if len(hits) == 1 else min(hits, key=_rank)
        # path-qualified: [[summary/hunk-dev]]
        norm = target.lstrip("./")
        for key in (norm, norm + ".md"):
            k = key[:-3] if key.endswith(".md") else key
            if k in self.pages:
                return k
        base = os.path.basename(norm)
        if base in self.by_basename:
            return min(self.by_basename[base], key=_rank)
        return None

    def _link(self):
        """Populate resolved edges, inbound counts, and declared provenance."""
        self.inbound = defaultdict(set)
        for key, p in self.pages.items():
            resolved, dead = [], []
            for t in p["links"]:
                r = self.resolve(t)
                (resolved.append(r) if r else dead.append(t))
            p["resolved"] = resolved
            p["dead_links"] = dead
            for r in resolved:
                self.inbound[r].add(key)
            # Declared provenance. The corpus cites its sources two ways --
            # *Sources: [[summary/SLUG]]* and *Sources: [[raw/SLUG]]* -- and
            # both mean "this page was built from that source". An archive
            # citation is credited to its digest; if the digest is missing, the
            # citation is dangling and the page cannot be recompiled from it.
            srcs, dangling = set(), []
            for r in set(resolved):
                if r.startswith("summary/"):
                    srcs.add(r)
                elif r.startswith("raw/"):
                    digest = "summary/" + r.split("/", 1)[1]
                    (srcs.add(digest) if digest in self.pages
                     else dangling.append(r))
            p["sources"] = sorted(srcs)
            p["dangling"] = sorted(dangling)

        # Reconstructed provenance for pages that declare none. A hub's sources
        # are the union of the digests of the pages it links to -- verified on
        # topic/Software Engineering Craft.md (55 links, 55 resolve, 51 with
        # provenance). Deterministic; no model required.
        for key, p in self.pages.items():
            if p["kind"] != "topic" or p["sources"]:
                p["recon_sources"] = []
                continue
            # BOUNDED to single-source neighbours. A page built from one source
            # effectively IS that source, so linking to it cites the source. A
            # multi-source page is a theme, and linking to a theme does not cite
            # the theme's whole bibliography -- inheriting it transitively is
            # what made one company's page claim 269 sources. Measured on the
            # live corpus: median reconstructed set 59 -> 8, and the 14 hubs
            # above the plausibility cap drop to 0.
            recon = set()
            for r in p["resolved"]:
                nb = self.pages.get(r)
                if nb and len(nb["sources"]) == 1:
                    recon.update(nb["sources"])
            p["recon_sources"] = sorted(recon)

    def topics(self):
        return [p for p in self.pages.values() if p["kind"] == "topic"]

    def provenance(self, p):
        return p["sources"] or p["recon_sources"]


# --------------------------------------------------------------------------
# audit checks. Each returns (id, title, [items]); deterministic and cheap.
# --------------------------------------------------------------------------

def check_dead_links(v):
    items = []
    for p in sorted(v.pages.values(), key=lambda x: x["key"]):
        for t in sorted(set(p["dead_links"])):
            items.append({"page": p["path"], "target": t})
    return ("dead-links", "Wikilinks that resolve to nothing", items)


def check_orphans(v):
    items = [{"page": p["path"], "words": p["words"]}
             for p in sorted(v.topics(), key=lambda x: -x["words"])
             if not v.inbound.get(p["key"])]
    return ("orphans", "Topic pages nothing links to", items)


def check_no_provenance(v):
    items = []
    for p in sorted(v.topics(), key=lambda x: -x["words"]):
        if not v.provenance(p):
            items.append({"page": p["path"], "words": p["words"]})
    return ("no-provenance",
            "Topic pages with no sources, declared or reconstructable", items)


def check_reconstructed(v):
    items = []
    for p in sorted(v.topics(), key=lambda x: -len(x["recon_sources"])):
        if not p["sources"] and p["recon_sources"]:
            items.append({"page": p["path"], "words": p["words"],
                          "reconstructed": len(p["recon_sources"])})
    return ("reconstructed-provenance",
            "Hubs whose sources were recovered from the link graph", items)


def check_single_source(v):
    items = [{"page": p["path"], "source": p["sources"][0]}
             for p in sorted(v.topics(), key=lambda x: x["key"])
             if len(p["sources"]) == 1]
    return ("single-source",
            "Topic pages built from exactly one source (digest with opinions)",
            items)


def check_dangling_sources(v):
    """Archive citations with no digest -- the page cannot be recompiled."""
    items = []
    for p in sorted(v.topics(), key=lambda x: x["key"]):
        for s in p.get("dangling", []):
            items.append({"page": p["path"], "archive": s,
                          "missing": "summary/" + s.split("/", 1)[1]})
    return ("dangling-provenance",
            "Pages citing an archive whose digest is missing", items)


def check_orphan_digests(v):
    cited = set()
    for p in v.topics():
        cited.update(v.provenance(p))
    items = [{"page": p["path"]}
             for p in sorted(v.pages.values(), key=lambda x: x["key"])
             if p["kind"] == "summary" and p["key"] not in cited]
    return ("uncited-digests", "Digests no topic page draws on", items)


def check_missing_digest(v):
    raws = {p["key"].split("/", 1)[1] for p in v.pages.values()
            if p["kind"] == "raw"}
    sums = {p["key"].split("/", 1)[1] for p in v.pages.values()
            if p["kind"] == "summary"}
    items = ([{"slug": s, "issue": "raw without digest"}
              for s in sorted(raws - sums)]
             + [{"slug": s, "issue": "digest without archive"}
                for s in sorted(sums - raws)])
    return ("archive-digest-mismatch", "Archive and digest out of step", items)


def check_stale_counts(v):
    actual = len(v.topics())
    items = []
    for p in sorted(v.pages.values(), key=lambda x: x["key"]):
        # raw/ is verbatim third-party text; someone else's "my wiki has 500
        # pages" is not a claim this wiki is making.
        if not p["authored"]:
            continue
        for m in SELF_COUNT.finditer(p["body"]):
            claimed = int(m.group(1).replace(",", ""))
            # Only flag a real drift; "~1000" against 1017 is honest enough.
            if abs(claimed - actual) > max(25, actual * 0.05):
                items.append({"page": p["path"], "claims": claimed,
                              "actual": actual,
                              "text": m.group(0).strip()})
    return ("stale-self-counts",
            "Pages asserting a page count that has drifted", items)


def check_wanted(v, floor=2):
    """Dead link targets ranked by demand.

    A page that several others link to but which does not exist is not merely a
    broken link -- it is the corpus naming a theme it wants. This is MediaWiki's
    "most wanted pages", and it is the cheapest theme-discovery signal there is.
    """
    want = defaultdict(set)
    for p in v.pages.values():
        for t in set(p["dead_links"]):
            want[t].add(p["path"])
    items = [{"wanted": t, "by": len(ps), "pages": sorted(ps)[:4]}
             for t, ps in want.items() if len(ps) >= floor]
    items.sort(key=lambda x: (-x["by"], x["wanted"]))
    return ("wanted-pages",
            f"Absent pages that {floor}+ other pages link to (theme demand)",
            items)


def check_duplicate_titles(v):
    dupes = defaultdict(list)
    for p in v.topics():
        dupes[p["title"].lower()].append(p["path"])
    items = [{"title": t, "pages": sorted(ps)}
             for t, ps in sorted(dupes.items()) if len(ps) > 1]
    return ("duplicate-titles", "Topic pages sharing a title", items)


def check_oversized(v, limit=2500):
    items = [{"page": p["path"], "words": p["words"]}
             for p in sorted(v.topics(), key=lambda x: -x["words"])
             if p["words"] > limit]
    return ("oversized",
            f"Topic pages over {limit} words (candidates for splitting)", items)


CHECKS = [
    check_dead_links, check_wanted, check_no_provenance, check_dangling_sources,
    check_stale_counts, check_duplicate_titles, check_orphans,
    check_oversized, check_reconstructed, check_single_source,
    check_orphan_digests, check_missing_digest,
]


def cmd_index(v, args):
    topics = v.topics()
    declared = [p for p in topics if p["sources"]]
    multi = [p for p in topics if len(p["sources"]) > 1]
    recon = [p for p in topics if not p["sources"] and p["recon_sources"]]
    stats = {
        "archive": sum(1 for p in v.pages.values() if p["kind"] == "raw"),
        "digests": sum(1 for p in v.pages.values() if p["kind"] == "summary"),
        "topics": len(topics),
        "topics_declaring_sources": len(declared),
        "topics_multi_source": len(multi),
        "topics_single_source": len(declared) - len(multi),
        "topics_provenance_reconstructed": len(recon),
        "topics_no_provenance": len(topics) - len(declared) - len(recon),
        "wikilinks": sum(len(p["links"]) for p in v.pages.values()),
        "dead_wikilinks": sum(len(p["dead_links"]) for p in v.pages.values()),
    }
    if args.json:
        print(json.dumps(stats, indent=2))
        return 0
    print("Corpus")
    for k in ("archive", "digests", "topics"):
        print(f"  {k:<34}{stats[k]:>6}")
    print("\nProvenance")
    for k in ("topics_multi_source", "topics_single_source",
              "topics_provenance_reconstructed", "topics_no_provenance"):
        print(f"  {k:<34}{stats[k]:>6}")
    print("\nGraph")
    for k in ("wikilinks", "dead_wikilinks"):
        print(f"  {k:<34}{stats[k]:>6}")
    return 0


def cmd_audit(v, args):
    limit = getattr(args, 'oversized', 2500)
    results = [(c(v, limit) if c is check_oversized else c(v)) for c in CHECKS]
    if args.json:
        print(json.dumps(
            [{"id": i, "title": t, "count": len(x), "items": x}
             for i, t, x in results], indent=2))
        return 0
    total = 0
    for cid, title, items in results:
        total += len(items)
        flag = "  " if not items else "!!"
        print(f"{flag} {len(items):>5}  {title}  [{cid}]")
        for it in items[:args.show]:
            bits = ", ".join(f"{k}={v_}" for k, v_ in it.items()
                             if k not in ("text",))
            print(f"          {bits}")
        if len(items) > args.show:
            print(f"          ... and {len(items) - args.show} more"
                  f" (--show N, or --json)")
    print(f"\n{total} findings across {len(results)} checks.")
    return 0


def _norm_title(s):
    return re.sub(r"[^a-z0-9 ]", " ", s.lower()).split()


def cmd_classify(v, args):
    """Split single-source pages into entity pages and editorial concepts.

    The signal is deterministic and already in the corpus: compare a page's
    title with the title of the ONE source it is built from. A page named after
    its source ("Hunk" <- "Hunk - Diff Viewer") is an ENTITY page -- a thing
    that exists in the world, legitimately 1:1, and whose factual content
    duplicates its own digest. A page whose title its source never uses
    ("Constraint Decay") is a CONCEPT the author coined, and concepts want to be
    themes: multi-source, argued, compiled.

    This only reports. Deciding what to do with 900-odd pages is not a call a
    heuristic should make unattended.
    """
    ent, con = [], []
    for p in v.topics():
        srcs = p["sources"]
        if len(srcs) != 1:
            continue
        d = v.pages.get(srcs[0])
        stitle = (d["meta"].get("title") if d else "") or ""
        a, b = set(_norm_title(p["title"])), set(_norm_title(stitle))
        overlap = len(a & b) / max(1, len(a))
        row = {"page": p["title"], "source_title": stitle,
               "overlap": round(overlap, 2), "words": p["words"],
               "inbound": len(v.inbound.get(p["key"], ()))}
        (ent if overlap >= args.threshold else con).append(row)
    ent.sort(key=lambda r: -r["overlap"]); con.sort(key=lambda r: -r["inbound"])
    if args.json:
        print(json.dumps({"entity": ent, "concept": con}, indent=2))
        return 0
    print(f"ENTITY-LIKE   {len(ent):>4}  named after their source; the factual "
          f"content duplicates the digest")
    for r in ent[:args.show]:
        print(f"    {r['overlap']:.2f}  {r['page']}  <-  {r['source_title'][:44]}")
    print(f"\nCONCEPT-LIKE  {len(con):>4}  titles the source never uses; these "
          f"want to become themes")
    for r in con[:args.show]:
        print(f"    {r['inbound']:>3} inbound  {r['page']}")
    print(f"\n{len(ent)+len(con)} single-source pages classified "
          f"at threshold {args.threshold}.")
    return 0


def cmd_dirty(v, args):
    """Themes a batch of new sources actually touched.

    The join between the two halves of the design. Recompiling "the top N"
    after an ingest is a guess; a theme is dirty when its own declared source
    set intersects the digests that changed. Set arithmetic over provenance --
    no model, no retrieval, no guessing.

    The blind spot is honest and unavoidable here: a source belonging to a theme
    nobody has declared yet is invisible to this, because the edge does not
    exist. That is the new-edge problem, and the backstop is an occasional full
    recompile rather than a cleverer diff.
    """
    import subprocess
    r = subprocess.run(["git", "-C", v.wiki, "diff", "--name-only",
                        f"{args.since}..HEAD", "--", "summary/"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"git diff {args.since}..HEAD failed: {r.stderr.strip()}", 4)
    changed = {nfc(l)[:-3] for l in r.stdout.split("\n")
               if l.strip().endswith(".md")}
    if not changed:
        if not args.json:
            print(f"No digests changed since {args.since}.")
        else:
            print("[]")
        return 0
    rows = []
    for p in v.topics():
        hit = sorted(set(v.provenance(p)) & changed)
        if len(hit) and len(v.provenance(p)) >= args.min:
            rows.append({"theme": p["title"], "sources": len(v.provenance(p)),
                         "changed": len(hit)})
    rows.sort(key=lambda x: (-x["changed"], -x["sources"]))
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    for x in rows:
        print(x["theme"])
    print(f"\n{len(changed)} digest(s) changed; {len(rows)} theme(s) dirty.",
          file=sys.stderr)
    return 0


def cmd_gaps(v, args):
    """Harvest every compiled page's "What's Missing" section.

    Closing the loop the corpus cannot close for itself: a compiled theme knows
    what its evidence does NOT cover, and collectively those admissions are a
    reading list. This is the anti-stagnation input -- an agent-maintained wiki
    left to its own devices converges on a fixed point.
    """
    out = []
    for p in sorted(v.topics(), key=lambda x: x["title"]):
        body = p["body"]
        m = re.search(r"^##+\s*What'?s Missing\s*$", body, re.M | re.I)
        if not m:
            continue
        rest = body[m.end():]
        nxt = re.search(r"^(##\s|\*Compiled from|---\s*$)", rest, re.M)
        section = rest[:nxt.start()] if nxt else rest
        for g in re.findall(r"^\*\*(.+?)\.?\*\*", section, re.M):
            out.append({"theme": p["title"], "gap": g.strip()})
    if args.json:
        print(json.dumps(out, indent=2))
        return 0
    cur = None
    for r in out:
        if r["theme"] != cur:
            cur = r["theme"]
            print(f"\n{cur}")
        print(f"  - {r['gap']}")
    print(f"\n{len(out)} gaps across "
          f"{len({r['theme'] for r in out})} compiled themes.")
    return 0


def cmd_fixme(v, args):
    """Corrections the reader left inline, as %%fix: ...%% Obsidian comments.

    Reading is the highest-quality curation signal available and it is free,
    because the reading was going to happen anyway. This makes noticing
    something wrong cost five seconds instead of a task-switch.
    """
    pat = re.compile(r"%%\s*fix:\s*(.+?)%%", re.S | re.I)
    out = []
    for p in sorted(v.pages.values(), key=lambda x: x["key"]):
        if not p["authored"]:
            continue
        for m in pat.finditer(p["body"]):
            out.append({"page": p["path"],
                        "note": " ".join(m.group(1).split())})
    if args.json:
        print(json.dumps(out, indent=2))
        return 0
    for r in out:
        print(f"{r['page']}\n  {r['note']}")
    print(f"\n{len(out)} correction(s) pending.")
    return 0


def cmd_sources(v, args):
    """The source set for one theme -- the compiler's input contract."""
    match = [p for p in v.topics()
             if p["title"].lower() == args.theme.lower()]
    if not match:
        die(f"no topic page titled {args.theme!r}", 4)
    p = match[0]
    srcs = v.provenance(p)
    out = {
        "theme": p["title"],
        "path": p["path"],
        "words": p["words"],
        "provenance": "declared" if p["sources"] else
                      ("reconstructed" if p["recon_sources"] else "none"),
        "sources": [v.pages[s]["path"] for s in srcs if s in v.pages],
        "archives": [f"raw/{s.split('/', 1)[1]}.md" for s in srcs
                     if f"raw/{s.split('/', 1)[1]}" in v.pages],
    }
    if args.json:
        print(json.dumps(out, indent=2))
    else:
        print(f"{out['theme']}  ({out['provenance']}, {len(out['sources'])} sources)")
        for s in out["sources"]:
            print(f"  {s}")
    return 0


def cmd_themes(v, args):
    rows = []
    for p in v.topics():
        srcs = v.provenance(p)
        if len(srcs) >= args.min:
            rows.append((len(srcs), p["words"], p["title"],
                         "declared" if p["sources"] else "reconstructed"))
    rows.sort(reverse=True)
    if args.json:
        print(json.dumps([{"sources": s, "words": w, "title": t, "provenance": k}
                          for s, w, t, k in rows], indent=2))
        return 0
    print(f"{'src':>4} {'words':>6}  {'provenance':<14} title")
    for s, w, t, k in rows:
        print(f"{s:>4} {w:>6}  {k:<14} {t}")
    print(f"\n{len(rows)} pages with >= {args.min} sources.")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="wiki-curate", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--wiki", help="wiki root (default: $WIKI_PATH)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("index", help="build the graph and print a summary")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_index)

    p = sub.add_parser("audit", help="deterministic health report")
    p.add_argument("--json", action="store_true")
    p.add_argument("--show", type=int, default=5,
                   help="example items per check (default 5)")
    p.add_argument("--oversized", type=int, default=2500,
                   help="word count above which a page is a split candidate "
                        "(default 2500; compiled themes run larger because "
                        "they carry their own directory section)")
    p.set_defaults(fn=cmd_audit)

    p = sub.add_parser("classify", help="entity pages vs editorial concepts")
    p.add_argument("--threshold", type=float, default=0.5)
    p.add_argument("--show", type=int, default=6)
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_classify)

    p = sub.add_parser("dirty", help="themes whose sources changed since a ref")
    p.add_argument("--since", required=True, metavar="REF")
    p.add_argument("--min", type=int, default=2,
                   help="minimum total sources for a theme (default 2)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_dirty)

    p = sub.add_parser("gaps", help="what compiled themes say they are missing")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_gaps)

    p = sub.add_parser("fixme", help="pending %%fix: ...%% corrections")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_fixme)

    p = sub.add_parser("sources", help="the source set for one theme")
    p.add_argument("--theme", required=True)
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_sources)

    p = sub.add_parser("themes", help="pages ranked by source count")
    p.add_argument("--json", action="store_true")
    p.add_argument("--min", type=int, default=2,
                   help="minimum sources (default 2)")
    p.set_defaults(fn=cmd_themes)

    args = ap.parse_args(argv)
    return args.fn(Vault(resolve_wiki(args.wiki)), args)


if __name__ == "__main__":
    sys.exit(main())
