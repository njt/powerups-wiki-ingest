#!/bin/bash
# wiki-ingest-fetch <url> | --file <path> — fetch/extract a source to cleaned
# Markdown on stdout. Uses trafilatura (readability extraction).
#
# YouTube is the one exception: youtube.com / youtu.be URLs go through ytx
# (github.com/gnat/ytx), which prints a markdown transcript headed by the video
# title. curl|trafilatura on YouTube only ever returns the app-shell footer, so
# without ytx a YouTube URL is exit 3 — never a fall-through to curl.
#
# Exit codes:
#   0  non-empty content extracted (printed to stdout)
#   3  nothing meaningful extracted (empty) — caller treats as fetch failure;
#      also a YouTube URL with ytx missing or failing
#   1  tool missing / usage error
#
# TRAFILATURA env var overrides the binary path (default: trafilatura on PATH,
# else ~/.local/bin/trafilatura). WIKI_INGEST_YTX overrides the ytx binary
# (default: ytx on PATH).
set -u

TRAF="${TRAFILATURA:-}"
if [ -z "$TRAF" ]; then
  if command -v trafilatura >/dev/null 2>&1; then TRAF="trafilatura"
  elif [ -x "$HOME/.local/bin/trafilatura" ]; then TRAF="$HOME/.local/bin/trafilatura"
  else echo "wiki-ingest-fetch: trafilatura not found (pipx install trafilatura)" >&2; exit 1; fi
elif ! command -v "$TRAF" >/dev/null 2>&1; then
  # Explicit override that doesn't resolve — fail loudly instead of silently
  # extracting nothing and looking like an empty page.
  echo "wiki-ingest-fetch: TRAFILATURA='$TRAF' is not executable" >&2; exit 1
fi

MODE="url"; SRC=""
case "${1:-}" in
  --file) [ $# -ge 2 ] || { echo "usage: wiki-ingest-fetch --file <path>" >&2; exit 1; }; MODE="file"; SRC="$2" ;;
  "" ) echo "usage: wiki-ingest-fetch <url> | --file <path>" >&2; exit 1 ;;
  -* ) echo "wiki-ingest-fetch: unknown option: $1" >&2; exit 1 ;;
  * ) SRC="$1" ;;
esac

# is_youtube_url <url> — host is youtube.com, any *.youtube.com (www., m.,
# music.), or youtu.be. Deliberately stricter than ytx's own matcher
# (cmd/ytx/main.go isYouTubeURL: substring "youtube.com/" or "youtu.be/"),
# which would also match unrelated hosts with those strings in a path.
# bin/wiki-ingest-run carries a copy of this helper for its title-slug rule;
# the two must agree.
is_youtube_url() {
  local u="$1"
  u="${u#http://}"; u="${u#https://}"
  case "$u" in
    youtube.com/*|*.youtube.com/*|youtu.be/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Honest, identifiable User-Agent (env-overridable). curl does the fetch —
# explicit UA + timeout + redirect handling — and trafilatura does readability
# extraction from the returned HTML. This gives us full UA control (trafilatura's
# --config-file replaces its whole settings schema, too fragile) and empirically
# succeeds on sites that block trafilatura's own default fetch.
UA="${WIKI_INGEST_UA:-wiki-ingest/1.0 (+https://github.com/njt/powerups-wiki-ingest; personal Obsidian wiki archiver)}"
TIMEOUT="${WIKI_INGEST_TIMEOUT:-30}"

# --markdown keeps headings/lists/quotes; extraction strips nav/ads/boilerplate.
if [ "$MODE" = "file" ]; then
  out=$("$TRAF" --markdown < "$SRC" 2>/dev/null)
elif is_youtube_url "$SRC"; then
  # ytx -no-gist -no-summary prints the transcript to stdout (per
  # cmd/ytx/main.go) as "# <title>" + metadata bullets + transcript (per
  # internal/publish/publish.go FormatTranscript). No gist, no LLM summary.
  YTX="${WIKI_INGEST_YTX:-}"
  if [ -z "$YTX" ]; then
    if command -v ytx >/dev/null 2>&1; then YTX="ytx"
    else
      echo "wiki-ingest-fetch: YouTube URL but ytx is not installed (go install github.com/gnat/ytx/cmd/ytx@latest) — nothing to extract" >&2
      exit 3
    fi
  elif ! command -v "$YTX" >/dev/null 2>&1; then
    echo "wiki-ingest-fetch: WIKI_INGEST_YTX='$YTX' is not executable" >&2; exit 1
  fi
  # ytx's stderr is kept: on failure it is the only thing that says WHY (no
  # audio, AssemblyAI error, missing key), and the orchestrator records that
  # reason in ingest-queue.md.
  yerr=$(mktemp "${TMPDIR:-/tmp}/wiki-ingest-ytx.XXXXXX")
  out=$("$YTX" -no-gist -no-summary "$SRC" 2>"$yerr"); yrc=$?
  if [ "$yrc" -ne 0 ]; then
    reason=$(tail -n 3 "$yerr" | tr '\n' ' ')
    rm -f "$yerr"
    echo "wiki-ingest-fetch: ytx failed (rc=$yrc) for $SRC — nothing to extract${reason:+: $reason}" >&2
    exit 3
  fi
  rm -f "$yerr"
else
  if ! command -v curl >/dev/null 2>&1; then
    echo "wiki-ingest-fetch: curl not found" >&2; exit 1
  fi
  out=$(curl -fsSL -A "$UA" --max-time "$TIMEOUT" "$SRC" 2>/dev/null | "$TRAF" --markdown 2>/dev/null)
fi

# Treat whitespace-only or trivially-short output as "nothing extracted".
trimmed=$(printf '%s' "$out" | tr -d '[:space:]')
if [ ${#trimmed} -lt 40 ]; then
  exit 3
fi
printf '%s\n' "$out"
exit 0
