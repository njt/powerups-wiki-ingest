#!/bin/bash
# wiki-compile — regenerate one theme page from the digests it is built from.
#
# This is the "compile" step of the curation design: topic pages are DERIVED
# artifacts, not a mutable store. Ingest files sources; this rebuilds a theme
# from all of them at once, which is the only way a page can be *revised*
# rather than merely appended to.
#
# Safety, in order of importance:
#   * The live wiki checkout is NEVER touched. All work happens in a throwaway
#     git worktree under /tmp, on a branch. Nat's Obsidian window stays on main.
#   * Nothing is merged. The branch is left for review; `git diff main..BRANCH`
#     is the deliverable.
#   * Output is validated before it is committed (page present, provenance
#     footer present, no conflict markers, not truncated, no cross-link lost).
#
# Topics (3.0). When the wiki being compiled carries topics.md, --theme must be
# a listed slug or title (anything else exits 3), the source set is every digest
# whose `topics:` names it, and the page path comes from the list -- so a topic
# with no page yet compiles: the worktree gets an empty topic/<Title>.md first
# and the link-preservation set is empty. Without topics.md the theme is an
# existing topic page and its sources are its provenance, as before.
#
# The source set is resolved against the BRANCH being built (BASE below), not
# the live checkout: a migration or retag branch carries topics.md and `topics:`
# lines that main does not have yet, and compiling onto that branch must see them.
# Off a fresh branch BASE is main, so this is the live checkout's state anyway.
#
# Usage:
#   wiki-compile --theme "Software Engineering Craft"
#   wiki-compile --theme agent-architecture       # a topics.md slug works too
#   wiki-compile --theme "..." --dry-run       # build context, skip the LLM
#   wiki-compile --theme "..." --branch curate/my-run
#
# Env: WIKI_PATH (required), WIKI_INGEST_CLI (default: claude; see wiki-agent)
#   WIKI_COMPILE_MODE  agentic (default): $WIKI_INGEST_CLI reads the context and
#                      writes the page with tools, run through wiki-agent.
#   WIKI_COMPILE_PI_MODEL  pi only: the model for compiles (default
#                      $WIKI_INGEST_PI_MODEL); a compile wants a bigger model
#                      than an ingest.
#                      single: ONE chat-completions call through wiki-llm with
#                      the context, the current page and its link list inlined;
#                      the script writes the page, and every gate below still
#                      applies. Needs WIKI_LLM_BASE_URL and a key (wiki-llm
#                      --help). Measured 30-75 s a topic against ~8 min.
#   WIKI_COMPILE_MODEL (default glm-5.3-flash-background), WIKI_COMPILE_EFFORT
#   (default high), WIKI_COMPILE_MAX_TOKENS (default 32000), WIKI_LLM (default
#   wiki-llm beside this script): single mode only.
# Exit: 0 compiled  2 usage/config  3 not a listed topic / too few sources
#       4 LLM failed  5 validation failed  6 the model never wrote the page
set -euo pipefail
# `set -e` aborts silently, which makes a failure in a long unattended batch
# indistinguishable from a mystery. Say where we died and with what.
trap 'rc=$?; [ "$rc" -eq 0 ] || echo "wiki-compile: aborted at line $LINENO (exit $rc)" >&2' ERR

THEME=""; BRANCH=""; DRY_RUN=0; KEEP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --theme)   THEME="${2:-}"; shift 2 ;;
    --branch)  BRANCH="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --keep)    KEEP=1; shift ;;
    -h|--help) sed -n '2,50p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "wiki-compile: unknown argument: $1" >&2; exit 2 ;;
  esac
done

[ -n "$THEME" ] || { echo "wiki-compile: --theme is required" >&2; exit 2; }
[ -n "${WIKI_PATH:-}" ] || { echo "wiki-compile: WIKI_PATH is not set" >&2; exit 2; }
[ -d "$WIKI_PATH/topic" ] || [ -f "$WIKI_PATH/topics.md" ] \
  || { echo "wiki-compile: no topic/ under $WIKI_PATH" >&2; exit 2; }
MODE="${WIKI_COMPILE_MODE:-agentic}"
case "$MODE" in
  agentic)
    AGENT="$(dirname "$0")/wiki-agent"
    [ -x "$AGENT" ] || { echo "wiki-compile: wiki-agent not found beside me" >&2; exit 2; } ;;
  single)
    LLM="${WIKI_LLM:-$(dirname "$0")/wiki-llm}"
    [ -x "$LLM" ] || { echo "wiki-compile: WIKI_COMPILE_MODE=single but $LLM is not executable" >&2; exit 2; } ;;
  *) echo "wiki-compile: WIKI_COMPILE_MODE must be agentic or single, not '$MODE'" >&2; exit 2 ;;
esac
CURATE="$(dirname "$0")/wiki-curate"
[ -x "$CURATE" ] || { echo "wiki-compile: wiki-curate not found beside me" >&2; exit 2; }

[ -n "$BRANCH" ] || BRANCH="curate/compile-$(date +%Y%m%d)"

# --- Throwaway worktree: the live checkout must never move -------------------
WT="$(mktemp -d "${TMPDIR:-/tmp}/wiki-compile-XXXXXX")"
# Single mode's prompt and reply live OUTSIDE the worktree, so the
# collateral-file check never sees them.
SCRATCH=""
cleanup() {
  [ -n "$SCRATCH" ] && rm -rf "$SCRATCH"
  if [ "$KEEP" -eq 1 ]; then
    echo "wiki-compile: worktree kept at $WT" >&2; return
  fi
  git -C "$WIKI_PATH" worktree remove --force "$WT" 2>/dev/null || rm -rf "$WT"
}
trap cleanup EXIT

# DETACHED on purpose. Checking the branch out here would make the compile fail
# for anything else holding it -- an audit worktree, a second compile, Nat's own
# checkout -- with a "already used by worktree" fatal. We build detached and
# move the branch ref afterwards, so the branch is never checked out anywhere.
BASE=$(git -C "$WIKI_PATH" rev-parse --verify --quiet "refs/heads/$BRANCH" \
       || git -C "$WIKI_PATH" rev-parse --verify main)
git -C "$WIKI_PATH" worktree add --quiet --detach "$WT" "$BASE"
# git materialises no empty directory, and wiki-curate refuses a root with no
# topic/. A wiki whose listed topics are all still uncompiled has exactly that.
mkdir -p "$WT/topic" "$WT/summary"

# --- Resolve the theme's source set (deterministic, via wiki-curate) ---------
# Against the worktree, i.e. the state of BASE: see the header for why. With
# topics.md present wiki-curate refuses an unlisted theme with exit 3 and says
# so; that message is the one the caller sees.
SRC_JSON="$("$CURATE" --wiki "$WT" sources --theme "$THEME" --json)" || exit 3
N_SRC=$(printf '%s' "$SRC_JSON" | python3 -c 'import json,sys;print(len(json.load(sys.stdin)["sources"]))')
PAGE_REL=$(printf '%s' "$SRC_JSON" | python3 -c 'import json,sys;print(json.load(sys.stdin)["path"])')
PROV=$(printf '%s' "$SRC_JSON" | python3 -c 'import json,sys;print(json.load(sys.stdin)["provenance"])')
# Only the topics.md path reports these; the legacy path implies an existing page.
PAGE_EXISTS=$(printf '%s' "$SRC_JSON" | python3 -c 'import json,sys;print("1" if json.load(sys.stdin).get("page_exists", True) else "0")')
SCOPE=$(printf '%s' "$SRC_JSON" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("scope") or "")')

if [ "$N_SRC" -lt 2 ]; then
  echo "wiki-compile: '$THEME' has $N_SRC source(s); a theme page needs 2+." >&2
  echo "wiki-compile: single-source material belongs in summary/, not topic/." >&2
  exit 3
fi
echo "wiki-compile: $THEME — $N_SRC sources ($PROV provenance)"

# --- Bootstrap: a listed topic that has no page yet --------------------------
# Everything downstream assumes the page is on disk: the mtime back-dating that
# tells a dead model from a genuine no-op, the prompt's "read the current
# version", and the HEAD: read in the link-preservation gate. Seed an empty file
# so those behave; `git show HEAD:path` then fails and reads as "no old links",
# which is exactly right for a first compile.
FIRST=0
if [ "$PAGE_EXISTS" = 0 ]; then
  FIRST=1
  mkdir -p "$WT/$(dirname "$PAGE_REL")"
  : > "$WT/$PAGE_REL"
  echo "wiki-compile: $PAGE_REL does not exist yet — this is a first compile"
fi

# --- Assemble the context: every digest, in one file the model must read -----
# Concatenating rather than handing over a list of paths is deliberate: it
# guarantees the compiler sees ALL the evidence, in one Read, instead of
# sampling whichever files it feels like opening.
CTX="$WT/.compile-context.md"
{
  printf '# Compilation context for: %s\n\n' "$THEME"
  printf 'Digests: %s. Every one is evidence for this theme.\n\n---\n\n' "$N_SRC"
  printf '%s' "$SRC_JSON" | WIKI_ROOT="$WT" python3 -c '
import json,sys,os
d=json.load(sys.stdin); wiki=os.environ["WIKI_ROOT"]
notes=d.get("notes") or {}
for rel in d["sources"]:
    p=os.path.join(wiki,rel)
    try:
        with open(p,encoding="utf-8",errors="replace") as fh: body=fh.read()
    except OSError: continue
    print(f"\n## SOURCE: {rel}\n")
    # The wiki analysis page for this digest, by exact title, so the compiler
    # can link it. Digests do not name their notes; without this line a first
    # compile links nothing but summary/ slugs.
    for t in notes.get(rel, []):
        print(f"Note page: [[{t}]]")
    if notes.get(rel): print()
    print(body.strip())
    print("\n---")
'
} > "$CTX"
CTX_WORDS=$(wc -w < "$CTX" | tr -d ' ')
echo "wiki-compile: context assembled — $CTX_WORDS words from $N_SRC digests"

if [ "$DRY_RUN" -eq 1 ]; then
  cp "$CTX" "${TMPDIR:-/tmp}/wiki-compile-context.md"
  echo "wiki-compile: DRY RUN — context at ${TMPDIR:-/tmp}/wiki-compile-context.md"
  exit 0
fi

# --- Compile ----------------------------------------------------------------
# The page is already on disk (the worktree is checked out from BASE), so
# "content unchanged" cannot distinguish a model that wrote nothing from one
# that legitimately reproduced the page. The mtime can: if the file was never
# touched, the model never wrote it.
# mtime resolution here is whole seconds, and the checkout and the model's write
# can land in the same one -- so back-date the file first. Any write at all
# moves it to now, which makes "never touched" unambiguous.
mtime_of() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
touch -t 200001010000 "$WT/$PAGE_REL" 2>/dev/null || true
PRE_MTIME=$(mtime_of "$WT/$PAGE_REL")
TODAY=$(date +%Y-%m-%d)
# Prompt fragments that exist only in topics mode. SCOPE is the topics.md scope
# line, verbatim; the digests carry their own `topics:` so the model can see
# which of them name this topic second.
CURRENT_NOTE=""
[ "$FIRST" = 1 ] && CURRENT_NOTE=" It is EMPTY: this is the
     first compile of this topic, so there are no existing links to preserve."
SCOPE_BLOCK=""
if [ -n "$SCOPE" ]; then
  SCOPE_BLOCK="SCOPE: $SCOPE
Sources whose topics: list names this topic second may be mentioned lightly
rather than argued at length.
A SOURCE block may carry a \"Note page: [[Title]]\" line: that is this wiki's
own analysis page for the source. Link it by that EXACT title where you draw
on the source, or list it under \"Also on This Theme\", so this page is also
the directory of its notes. Those titles are real pages; never shorten them.
"
fi
if [ "$MODE" = agentic ]; then
set +e
cat <<COMPILE_EOF | (cd "$WT" && WIKI_INGEST_PI_MODEL="${WIKI_COMPILE_PI_MODEL:-${WIKI_INGEST_PI_MODEL:-}}" \
  "$AGENT" --tools Read,Write --context "$WT")
You are COMPILING a wiki theme page. Wiki root: $WT

Read these two files first:
  1. .compile-context.md — the $N_SRC source digests this theme is built from.
     Read ALL of it. It is the complete evidence base.
  2. $PAGE_REL — the current version of this page.$CURRENT_NOTE

Then write exactly one file: $PAGE_REL

${SCOPE_BLOCK}WHAT YOU ARE DOING. This page is a DERIVED artifact. You are not appending to
it — you are rebuilding it from all $N_SRC sources at once. That means you may
and should REVISE: correct claims the evidence no longer supports, fix stale
counts and dates, merge duplicated passages, drop what does not earn its place,
and reorganise. Preserve genuinely good writing from the current version, but
you are not obliged to keep its structure.

WHAT MAKES THIS PAGE GOOD. It must ARGUE, not enumerate. A list of
one-paragraph-per-source is a failure. The reader wants to know what this
theme IS, what the sources collectively establish, where they DISAGREE, and
what is still unknown. Synthesis means comparison: name the tension between
sources, say which is more convincing and why.

Required structure:

# $THEME

A one-paragraph thesis: what this theme is and what the wiki now believes
about it. Sharp and falsifiable, not a topic sentence.

---

## The Argument

The substance, organised by IDEA rather than by source. Cite other pages
inline in double-bracket link syntax, using each page's EXACT existing title --
never an abbreviation of it. Compare and contrast.

## Where the Sources Disagree

Genuine tensions. If there are none, omit this section entirely rather than
inventing one.

## What's Missing

Gaps the evidence does not cover — the honest edges of what you can claim.

## Also on This Theme

EVERY double-bracket link that appeared in the current version of this page and which
you have NOT woven into the sections above, as a bullet list with a few words
each on what it covers. Omit this section only if there are none left over.

---

(Do NOT write a "Compiled from ..." provenance footer. The tool appends it
from the authoritative source list after you finish. Anything you write there
will be discarded.)

RULES.
- PRESERVE EVERY EXISTING LINK. This page is not only an argument, it is
  also a directory: for many pages it is their only inbound link, and dropping
  one strands it where nothing in the wiki points at it any more. Every wikilink
  in the current version MUST appear in your output, spelled EXACTLY as before —
  woven into the argument
  where it belongs, or listed under "Also on This Theme". This is checked
  mechanically and the compile is REJECTED if any link disappears. You may add
  links; you may not remove them.
- Ground every claim in the digests. If it is not in the evidence, do not assert it.
- Do NOT invent links to pages you have not seen named in the context or the
  current page, and never shorten a title into a new link. Both are checked
  mechanically and REJECT the compile. Dead links are a measured problem here.
- Do not write a page count or corpus statistic; those go stale and there is no
  reliable number available to you.
- Write for a smart reader who has not read the sources. British-neutral prose,
  no marketing register, no "in today's fast-paced world".
- Do NOT create, delete or modify any other file. One file: $PAGE_REL
- Do NOT run git. Do not touch .compile-context.md.
COMPILE_EOF
RC=$?
set -e
[ "$RC" -eq 0 ] || { echo "wiki-compile: LLM failed (exit $RC)" >&2; exit 4; }
else
# --- Single call: the context and the current page inlined, one request ------
# The same instructions as the agentic prompt above, minus the file and git
# rules the reply cannot break; the reply IS the page, and this script writes
# it. Everything downstream -- the untouched-file check, the provenance footer,
# the link gates, the collateral check -- runs exactly as for the agentic path.
# Measured 2026-09-13 (wiki-model-prompt-optimise SPEC-2): 30-75 s a topic on
# glm-5.3-flash at high effort, up to a 103k-token context, against ~8 min.
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/wiki-compile-single-XXXXXX")"
{
  printf "The wiki's CLAUDE.md (project instructions for the wiki you are working in):\n\n"
  if [ -f "$WT/CLAUDE.md" ]; then cat "$WT/CLAUDE.md"; else printf '(none)\n'; fi
} > "$SCRATCH/system.md"
# Command substitution drops trailing newlines, which is what the block layout
# below wants. Neither value is re-expanded inside the heredoc.
# The length target scales with the evidence: ~1,200 words under 25 members,
# 2,000 under 60, 3,000 above.
if [ "$N_SRC" -lt 25 ]; then LENGTH_TARGET=1200; elif [ "$N_SRC" -lt 60 ]; then LENGTH_TARGET=2000; else LENGTH_TARGET=3000; fi
# Every link the gate below will demand, extracted the way the gate extracts
# them, spelled exactly as on the page: models that drop a link mostly drop it
# silently, and a list they can check against is what stops that.
# NB: single-quoted program, so no single quotes inside it.
CUR_LINKS=$(PAGE="$WT/$PAGE_REL" python3 -c '
import os, re
t = open(os.environ["PAGE"], encoding="utf-8", errors="replace").read()
t = re.sub(r"`[^`\n]*`", "", re.sub(r"^```.*?^```", "", t, flags=re.M | re.S))
seen = []
for x in re.findall(r"\[\[([^\]\[]+?)\]\]", t):
    x = x.split("|")[0].split("#")[0].strip()
    if not x.startswith(("summary/", "raw/")) and x not in seen:
        seen.append(x)
print("\n".join("[[" + x + "]]" for x in seen))
')
CTX_TEXT=$(cat "$CTX")
CUR_TEXT=$(cat "$WT/$PAGE_REL")
cat > "$SCRATCH/prompt.md" <<COMPILE_SINGLE_EOF
You are COMPILING a wiki theme page.

Read these two inputs first (both are reproduced in full at the end of this message):
  1. The compilation context — the $N_SRC source digests this theme is built from.
     Read ALL of it. It is the complete evidence base.
  2. $PAGE_REL — the current version of this page.$CURRENT_NOTE

Then return exactly one page: the new $PAGE_REL, as markdown. Return only the
page: no preamble, no code fence, nothing after it.

${SCOPE_BLOCK}WHAT YOU ARE DOING. This page is a DERIVED artifact. You are not appending to
it — you are rebuilding it from all $N_SRC sources at once. That means you may
and should REVISE: correct claims the evidence no longer supports, fix stale
counts and dates, merge duplicated passages, drop what does not earn its place,
and reorganise. Preserve genuinely good writing from the current version, but
you are not obliged to keep its structure.

WHAT MAKES THIS PAGE GOOD. It must ARGUE, not enumerate. A list of
one-paragraph-per-source is a failure. The reader wants to know what this
theme IS, what the sources collectively establish, where they DISAGREE, and
what is still unknown. Synthesis means comparison: name the tension between
sources, say which is more convincing and why.

Required structure:

# $THEME

A one-paragraph thesis: what this theme is and what the wiki now believes
about it. Sharp and falsifiable, not a topic sentence.

---

## The Argument

The substance, organised by IDEA rather than by source. Cite other pages
inline in double-bracket link syntax, using each page's EXACT existing title --
never an abbreviation of it. Compare and contrast.

## Where the Sources Disagree

Genuine tensions. If there are none, omit this section entirely rather than
inventing one.

## What's Missing

Gaps the evidence does not cover — the honest edges of what you can claim.

## Also on This Theme

EVERY double-bracket link that appeared in the current version of this page and which
you have NOT woven into the sections above, as a bullet list with a few words
each on what it covers. Omit this section only if there are none left over.

---

(Do NOT write a "Compiled from ..." provenance footer. The tool appends it
from the authoritative source list after you finish. Anything you write there
will be discarded.)

RULES.
- PRESERVE EVERY EXISTING LINK. This page is not only an argument, it is
  also a directory: for many pages it is their only inbound link, and dropping
  one strands it where nothing in the wiki points at it any more. Every wikilink
  in the current version MUST appear in your output, spelled EXACTLY as before —
  woven into the argument
  where it belongs, or listed under "Also on This Theme". This is checked
  mechanically and the compile is REJECTED if any link disappears. You may add
  links; you may not remove them. The complete list is under "LINKS THAT MUST
  APPEAR" below; before you finish, check every one is in your page, spelled
  character for character (punctuation and commas included).
- Ground every claim in the digests. If it is not in the evidence, do not assert it.
- Do NOT invent links to pages you have not seen named in the context or the
  current page, and never shorten a title into a new link. Both are checked
  mechanically and REJECT the compile. Dead links are a measured problem here.
- Do not write a page count or corpus statistic; those go stale and there is no
  reliable number available to you.
- Write for a smart reader who has not read the sources. British-neutral prose,
  no marketing register, no "in today's fast-paced world".
- LENGTH: about $LENGTH_TARGET words for the page (1,200 for a topic under 25
  members, 2,000 under 60, 3,000 above; this one has $N_SRC). The link
  directory under "Also on This Theme" does not count towards it.
- Every claim cites a Note page by its EXACT title, in double-bracket link
  syntax, from the "Note page:" lines in the context or the links in the current
  version.
- "Also on This Theme" is a directory: one line per link, the link and at most
  a few words. No prose paragraphs there.
- Think briefly: the digests are the evidence; do not deliberate at length.

=== COMPILATION CONTEXT ===

$CTX_TEXT

=== CURRENT VERSION OF $PAGE_REL ===

$CUR_TEXT

=== LINKS THAT MUST APPEAR (every link in the current version) ===

$CUR_LINKS

=== END OF INPUTS ===
COMPILE_SINGLE_EOF
unset CTX_TEXT CUR_TEXT CUR_LINKS
set +e
"$LLM" --system "$SCRATCH/system.md" \
  --model "${WIKI_COMPILE_MODEL:-glm-5.3-flash-background}" \
  --effort "${WIKI_COMPILE_EFFORT:-high}" \
  --max-tokens "${WIKI_COMPILE_MAX_TOKENS:-32000}" \
  < "$SCRATCH/prompt.md" > "$SCRATCH/reply.md"
RC=$?
set -e
if [ "$RC" -eq 4 ]; then
  echo "wiki-compile: the reply was cut off at max_tokens; nothing written (raise WIKI_COMPILE_MAX_TOKENS)" >&2
  exit 4
fi
[ "$RC" -eq 0 ] || { echo "wiki-compile: LLM failed (wiki-llm exit $RC)" >&2; exit 4; }
# Unwrap what models put round a page -- a reasoning block, a code fence, a
# line of preamble before the title -- and write it. An empty result writes
# nothing, which the untouched-file check below reports as exit 6.
# NB: single-quoted program, so no single quotes inside it.
REPLY="$SCRATCH/reply.md" PAGE="$WT/$PAGE_REL" python3 -c '
import os, re
t = open(os.environ["REPLY"], encoding="utf-8", errors="replace").read()
t = re.sub(r"^\s*<think>.*?</think>\s*", "", t, flags=re.S).strip()
m = re.search(r"^```(?:markdown|md)?[ \t]*\n(# .*)\n```[ \t]*$", t, re.S | re.M)
if m:
    t = m.group(1).strip()
h = re.search(r"^# ", t, re.M)
if h and h.start() > 0 and not re.search(r"^#", t[:h.start()], re.M):
    t = t[h.start():]
if t:
    with open(os.environ["PAGE"], "w", encoding="utf-8") as fh:
        fh.write(t + "\n")
'
fi

# Did the model write at all? This MUST be asked before the footer is appended,
# because appending would itself touch the file and mask a dead model.
if [ -f "$WT/$PAGE_REL" ] && \
   [ "$(mtime_of "$WT/$PAGE_REL")" = "$PRE_MTIME" ]; then
  echo "wiki-compile: the model never wrote $PAGE_REL (file untouched)." >&2
  echo "wiki-compile: treating as failure, not as a no-op." >&2
  exit 6
fi

# --- Provenance is written by the tool, never by the model --------------------
# A 188-source page came back with 117 fabricated [[summary/...]] slugs. The
# footer is the one part of the page that must be exactly true -- it is what
# makes the page auditable and rebuildable -- and the script already knows the
# authoritative list. Asking a model to transcribe 188 identifiers was the
# error; strip whatever it wrote and append the real thing.
rm -f "$CTX"
if [ -f "$WT/$PAGE_REL" ]; then
  SRC_JSON="$SRC_JSON" PAGE="$WT/$PAGE_REL" TODAY="$TODAY" python3 -c '
import json, os, re
src = json.loads(os.environ["SRC_JSON"])["sources"]
slugs = [os.path.basename(s)[:-3] for s in src]
p = os.environ["PAGE"]
t = open(p, encoding="utf-8", errors="replace").read()
t = re.sub(r"^\*Compiled from .*$", "", t, flags=re.M)
t = re.sub(r"^\*Last compiled:.*$", "", t, flags=re.M)
t = t.rstrip()
# Do not stack a second horizontal rule on one the page already ends with.
t = re.sub(r"\n-{3,}$", "", t).rstrip()
t = t + "\n\n---\n\n*Compiled from " + str(len(slugs)) + " sources: " \
    + ", ".join("[[summary/" + s + "]]" for s in slugs) + "*\n" \
    + "*Last compiled: " + os.environ["TODAY"] + "*\n"
open(p, "w", encoding="utf-8").write(t)
'
fi
FAIL=""
[ -f "$WT/$PAGE_REL" ] || FAIL="page not written"
if [ -z "$FAIL" ]; then
  W=$(wc -w < "$WT/$PAGE_REL" | tr -d ' ')
  [ "$W" -ge 250 ] || FAIL="page suspiciously short ($W words)"
fi
if [ -z "$FAIL" ] && grep -qE '^(<<<<<<<|>>>>>>>) ' "$WT/$PAGE_REL"; then
  FAIL="conflict markers in output"
fi
if [ -z "$FAIL" ] && ! grep -q 'Compiled from' "$WT/$PAGE_REL"; then
  FAIL="no provenance footer"
fi
# Connectivity is not negotiable. A hub page is often the ONLY inbound link a
# page has; dropping links strands them. Measured: an early run cut 48 of 104
# links from one hub and pushed wiki-wide orphans from 106 to 114.
if [ -z "$FAIL" ]; then
  LOST=$(WT="$WT" PAGE_REL="$PAGE_REL" WIKI_PATH="$WIKI_PATH" python3 -c '
import os,re,subprocess,unicodedata
def nfc(x): return unicodedata.normalize("NFC", x)
LINK=re.compile(r"\[\[([^\]\[]+?)\]\]")
FENCE=re.compile(r"^```.*?^```",re.M|re.S); INLINE=re.compile(r"`[^`\n]*`")
def links(t):
    t=INLINE.sub("",FENCE.sub("",t))
    return {x.split("|")[0].split("#")[0].strip() for x in LINK.findall(t)
            if not x.startswith(("summary/","raw/"))}
wt,rel=os.environ["WT"],os.environ["PAGE_REL"]
# A first compile has no HEAD: version; git show fails and stdout is empty,
# which is the right answer (no old links), not an error.
old=subprocess.run(["git","-C",wt,"show",f"HEAD:{rel}"],
                   capture_output=True,text=True).stdout
new=open(os.path.join(wt,rel),encoding="utf-8",errors="replace").read()
lost=sorted(links(old)-links(new))
# A TRUNCATED link is judged too, but nothing else that is merely absent: a
# model shortened [[bb — The Agent Orchestrator as Normalizer]] to [[bb]],
# which reads as one link kept plus one added, so the drop check cannot see it.
# Only prefixes of a real page title count. A new link to a page that simply
# does not exist is left alone on purpose -- that is a WANTED page, the corpus
# naming a theme it lacks, and rejecting those would fight the design.
# NB: this program sits inside a single-quoted shell string, so it must contain
# no single quotes at all -- not even inside a nested join.
titles=set()
for d,_,fs in os.walk(wt):
    if ".git" in d.split(os.sep): continue
    titles.update(nfc(f[:-3]) for f in fs if f.endswith(".md"))
added={nfc(a) for a in links(new)-links(old)}
trunc=sorted(a for a in added
             if a not in titles and any(t != a and t.startswith(a) for t in titles))
parts=[]
if lost:  parts.append("dropped "+str(len(lost))+" cross-link(s): "+", ".join(lost[:4]))
if trunc: parts.append("truncated "+str(len(trunc))+" link(s): "+", ".join(trunc[:4]))
msg="; ".join(parts)
print(str(len(lost)+len(trunc))+"\t"+msg if msg else "")
')
  if [ -n "$LOST" ]; then
    FAIL="${LOST#*	}"
  fi
fi
# The compiler must not have touched anything else.
OTHER=$(git -C "$WT" status --porcelain -- . ':!'"$PAGE_REL" | head -5)
if [ -z "$FAIL" ] && [ -n "$OTHER" ]; then
  FAIL="modified other files: $(printf '%s' "$OTHER" | tr '\n' ' ')"
fi
if [ -n "$FAIL" ]; then
  echo "wiki-compile: VALIDATION FAILED — $FAIL" >&2
  echo "wiki-compile: nothing committed. Re-run with --keep to inspect." >&2
  exit 5
fi

git -C "$WT" add -- "$PAGE_REL"
if git -C "$WT" diff --cached --quiet; then
  echo "wiki-compile: no change to $PAGE_REL (already current)"
  exit 0
fi
git -C "$WT" commit --quiet -m "Compile topic/$THEME from $N_SRC sources

Rebuilt as a derived artifact rather than appended to, so stale claims and
duplicated passages could be revised. Provenance: $PROV." \
  --author="wiki-compile <noreply@wiki-ingest>"

# Advance the branch to the commit we just built detached. update-ref, NOT
# `branch -f`: branch -f refuses to move a branch that is checked out in any
# worktree, which reintroduces the whole-batch failure the detached build was
# meant to cure -- same effect, different message. update-ref has no such rule.
NEWREF=$(git -C "$WT" rev-parse HEAD)
if ! git -C "$WIKI_PATH" update-ref "refs/heads/$BRANCH" "$NEWREF" 2>/dev/null; then
  echo "wiki-compile: could not move $BRANCH" >&2
  echo "wiki-compile: the commit exists at $NEWREF — recover with:" >&2
  echo "  git -C \"\$WIKI_PATH\" update-ref refs/heads/$BRANCH $NEWREF" >&2
  exit 5
fi
NEW=$(wc -w < "$WT/$PAGE_REL" | tr -d ' ')
HOW="COMPILED"; [ "$FIRST" = 1 ] && HOW="COMPILED (first compile, page created)"
echo "wiki-compile: $HOW $PAGE_REL ($NEW words) on branch $BRANCH"
echo "wiki-compile: review with  git -C \"\$WIKI_PATH\" diff main..$BRANCH"
